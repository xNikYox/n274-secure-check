{
  "manifest_version": 2,
  "name": "n274 Secure Check",
  "version": "1.2.0",
  "description": "Prüft die aktuelle Website: Sicherheit (HTTPS, Zertifikat, Header, Cookies, Skripte), Leistung, SEO und Technik – alles lokal im Browser.",
  "author": "xNikYox",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "<all_urls>",
    "webRequest",
    "webRequestBlocking",
    "cookies",
    "tabs",
    "clipboardWrite",
    "storage",
    "alarms",
    "notifications"
  ],
  "background": {
    "scripts": [
      "lib/retire-db.js",
      "lib/retire.js",
      "lib/exposed.js",
      "lib/checks.js",
      "background.js",
      "watch.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "n274 Secure Check",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "seitenpruefer@xnikyox",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "interaction.js"
      ],
      "run_at": "document_start"
    }
  ]
}